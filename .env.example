# Copia este archivo a .env (ignorado por git) y completa los valores.

# API key de Gemini, plan gratuito: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo. flash-lite es el que menos cuota gratuita consume. Los resultados en
# data/cache/ quedan asociados al modelo que los produjo: si lo cambias, cada JD
# se vuelve a extraer (y a gastar cuota).
GEMINI_MODELO=gemini-3.5-flash-lite
